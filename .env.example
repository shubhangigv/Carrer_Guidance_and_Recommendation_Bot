# Copy this file to .env and fill in your own values. Never commit .env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=career_guidance

# Login tokens for the API. Make a long random secret (at least 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Career assistant chatbot (Google Gemini). Free key: https://aistudio.google.com -> "Get API key".
# Leave empty to run the assistant in offline mode (it lists matching careers instead of chatting).
GEMINI_API_KEY=
# Optional: which Gemini model to use. If Google retires it, the app picks an available "flash" model.
GEMINI_MODEL=gemini-2.5-flash
