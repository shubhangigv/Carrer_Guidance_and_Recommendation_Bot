# Copy this file to .env and fill in your own values. Never commit .env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=career_guidance

# Login tokens for the API. Make a long random secret (at least 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Career assistant chatbot (Google Gemini). Free key: https://aistudio.google.com -> "Get API key".
# Leave empty to run the assistant in offline mode (it lists matching careers instead of chatting).
GEMINI_API_KEY=
# Optional: which Gemini model to use. If Google retires it, the app picks an available "flash" model.
GEMINI_MODEL=gemini-3.5-flash
# Optional: models tried one by one when the main one is busy (503 "high demand", limit, timeout).
# GEMINI_BACKUP_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Which engine ranks careers: v3 (default, strength fit + CV-tuned weights) or v2.
ENGINE_VERSION=v3
# Education routes in config/career_paths.csv: "yes" shows routes not yet checked (labelled as such);
# set to "no" for the demo/report so only routes checked on the official sites are shown.
SHOW_UNVERIFIED_ROUTES=yes
# Field model (ml/field_model.py): trained at startup from data/raw/survey/responses.csv if that file is on
# this PC; suggests a field when a student picks no areas. "no" switches it off.
USE_FIELD_MODEL=yes
